{
    "name": "mizunashi-mana/dokuwiki-plugin-mdpage",
    "type": "dokuwiki-plugin",
    "description": "DokuWiki Markdown Plugin",
    "keywords": [
        "dokuwiki",
        "plugin",
        "markdown"
    ],
    "license": [
        "Apache-2.0",
        "GPL-2.0-or-later"
    ],
    "authors": [
        {
            "name": "Mizunashi Mana",
            "email": "mizunashi-mana@noreply.git"
        }
    ],
    "config": {
        "bin-dir": "bin"
    },
    "scripts": {
        "test": "phpunit",
        "lint-fix": "php-cs-fixer fix"
    },
    "require": {
        "php": "^8.0 || ^7.0",
        "cebe/markdown": "^1.2",
        "symfony/polyfill-ctype": "^1.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "geshi/geshi": "@dev",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "DokuWiki\\": "src/DokuWiki"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dokuwiki\\Test\\": "tests/DokuWiki/Test"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/splitbrain/dokuwiki"
        },
        {
            "type": "vcs",
            "url": "https://github.com/splitbrain/dokuwiki"
        }
    ]
}
